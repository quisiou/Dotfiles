;; eww/config/theme2.yuck


(defvar terminal_cmd "kitty")
(defvar active_ws "1")

(defpoll brightness_data
     :interval "1s"
     "./bin/get_brightness"
)

(defpoll cpu_data
     :interval "1s"
     "./bin/get_cpu_usage"
)

(defwidget bar []
     (box :class "bar"
          :orientation "h"
          (box :halign "start"
               :space-evenly false
               :spacing 10
               (menu)
               (workspaces)
          )
          (box :halign "center"
               :hexpand true
               (time :time get_time)
          )
          (box :halign "end"
               :space-evenly false
               :spacing 10
               (eventbox :onhoverlost "bash -c 'eww update keyrev=false keyhov=false wifirev=false wifihov=false'"
                    (box :space-evenly false
                         :spacing 10
                         (tray)
                         (volume)
                         (brightness)
                         (battery)
                         (wifi)
                    )
               )
               ; (divider)
               (power)
          )
     )
)

(defvar trayrev false)

(defwidget tray []
     (box :orientation "h"
          :space-evenly false
          :class "tray-container"
          (revealer
               :reveal trayrev
               :transition "slideleft"
               :duration "350ms"
               (box :class "systray-shadow"
                    (systray
                         :spacing 5
                         :icon-size 16
                         :prepend-new true
                    )
               )
          )
          (eventbox :class "tray-button"
               :width 20
               :onclick "eww update trayrev=${!trayrev}"
               :cursor "pointer"
               (label :class "tray-text"
                    :text {trayrev ? "›" : "‹"}
               )
          )
     )
)

(defpoll volume_data
     :interval "1s"
     "./bin/get_volume"
)

(defwidget volume []
     (eventbox :onscroll "eww update volume_data=\"$(./bin/set_volume -i {} -o ${volume_data.volume})\""
          :cursor "pointer"
          (box :class "volume-short"
               (box :orientation "h"
                    :space-evenly false
                    (label
                         :text "${volume_data.icon}"
                         :style "margin-right:3px;"
                    )
                    (label
                         :class "bsht"
                         :text "${volume_data.volume}%"
                    )
               )
          )
     )
)

(defpoll ram_data
     :interval "1s"
     "./bin/get_ram_usage"
)

(defpoll disk_data
     :interval "1s"
     "./bin/get_disk_usage"
)

(defwidget brightness []
     (eventbox :onscroll "eww update brightness_data=\"$(./bin/set_brightness -i {} -o ${brightness_data.brightness})\""
          :cursor "pointer"
          (box :class "brightness-short"
               (box
                    :orientation "h"
                    :space-evenly false
                    (label
                         :text " "
                         :style "margin-right: 3px;"
                    )
                    (label :class "bsht"
                         :text "${brightness_data.brightness}%"
                    )
               )
          )
     )
)

(defpoll battery_data
     :interval "2s"
     "./bin/get_battery"
)

(defwidget battery []
     (box :class "battery"
          :tooltip "${battery_data.time_left}"
     (box
          :orientation "h"
          :space-evenly false
          (box :class "batico-short"
               (label
                    :text "${battery_data.icon}"
               )
          )
          (label :class "bsht"
               :text "${battery_data.capacity}%")
     )
     )
)

(defpoll wifistatus
     :interval "1s"
     :initial "{\"icon\": \"󰤮 \", \"ssid\": \"Disconnected\", \"strength\": 0}"
     "./bin/get_netinfo"
)

(defpoll network
     :interval "5s"
     :initial "[]"
     "./bin/get_netlist"
)

(defvar wifirev false)
(defvar wifihov false)
(defvar wifictlrev false)

(defwidget wifi []
     (box :class "wifi"
          (eventbox :cursor "pointer"
               :onhover "./scripts/wifi-delay.sh"
               :onhoverlost "eww update wifirev=false wifihov=false"
               :onclick "./scripts/wifictl.sh"
               (box
                    :orientation "h"
                    :space-evenly false
                    (label
                         :text "${wifistatus.icon} "
                    )
                    (label
                         :class "space-wifi"
                         :text " "
                    )
                    (revealer
                         :reveal {wifirev || wifictlrev}
                         :transition "slideright"
                         :duration "350ms"
                         (box :class "wifi-type"
                              :space-evenly false
                              (label :class "wifi-div"
                                   :text "|"
                              )
                              (label
                                   :limit-width 12
                                   :text "${wifistatus.ssid}"
                              )
                         )
                    )
               )
          )
     )
)

(defwidget wifi_event []
     (eventbox :class "shadow-container"
          :onhoverlost "./scripts/wifictl.sh"
          (box
               :orientation "v"
               :space-evenly false
               (box :class "wifictl-container"
                    :space-evenly false
                    :orientation "v"
                    (box :class "wifi-header"
                         :space-evenly false
                         (label
                              :text "Network Manager"
                         )
                    )
                    (box :class "wifi-stats"
                         :space-evenly false
                         (label :text "STATUS : ")
                         (label :class {wifistatus.ssid == "Disconnected" ? "nocon" : "yescon"}
                              :limit-width 27
                              :text  {wifistatus.ssid == "Disconnected" ? " Disconnected" : " Connected to ${wifistatus.ssid}"}
                         )
                    )
                    (scroll :class "network-container"
                         :vscroll true
                         :height 200
                         (box
                              :orientation "v"
                              :space-evenly false
                              (for i in network
                                   (wifi-option
                                        :ssid {i.ssid}
                                        :inuse {i.in_use}
                                        :auto {i.autoconnect}
                                   )
                              )
                         )
                    )
               )
               (revealer
                    :reveal {wificonfigrev}
                    :transition "slidedown"
                    :duration "350ms"
                    (eventbox
                         :onhoverlost "eww update wificonfigrev=false"
                         (box :class "wifictl-container"
                              :space-evenly false
                              :orientation "v"
                              (box :class "swifi-header"
                                   :space-evenly false
                                   (label
                                        :text "${wifissidrev}"
                                   )
                              )
                              (box :class "wifi-bcon"
                                   :orientation "h"
                                   :visible {wificlass=="1"?true:false}
                                   (box :class "wifi-buttons"
                                        (input :class "iwifi"
                                             :password true
                                             :space-evenly false
                                             :height 30
                                             :onaccept "eww update wificonfigrev=false && nmcli device wifi connect \"${wifissidrev}\" password \"{}\""
                                        )
                                   )
                              )
                              (box :class "wifi-bcon"
                                   :orientation "h"
                                   :spacing 10
                                   :visible {wificlass=="2"?true:false}
                                   (eventbox :class "wifi-buttons"
                                        :cursor "pointer"
                                        :height 30
                                        :onclick "eww update wificonfigrev=false && nmcli device wifi connect \"${wifissidrev}\""
                                        (label
                                             :text "Connect"
                                        )
                                   )
                                   (eventbox :class "wifi-buttons"
                                        :cursor "pointer"
                                        :onclick "eww update wificonfigrev=false && nmcli connection delete \"${wifissidrev}\""
                                        (label
                                             :text "Remove"
                                        )
                                   )
                              )
                              (box :class "wifi-bcon"
                                   :orientation "h"
                                   :spacing 10
                                   :visible {wificlass=="3"?true:false}
                                   (eventbox :class "wifi-buttons"
                                        :cursor "pointer"
                                        :onclick "eww update wificonfigrev=false && nmcli device disconnect wlp0s20f3"
                                        :height 30
                                        (label
                                             :text "Disconnect"
                                        )
                                   )
                                   (eventbox :class "wifi-buttons"
                                        :cursor "pointer"
                                        :onclick "eww update wificonfigrev=false && nmcli connection delete \"${wifissidrev}\""
                                        (label
                                             :text "Remove"
                                        )
                                   )
                              )
                         )
                    )
               )
          )
     )
)

(defvar wificonfigrev false)
(defvar wifissidrev "")
(defvar wificlass "")

(defwidget wifi-option [ssid auto inuse]
     (eventbox
          :cursor "pointer"
          :onclick "eww update wificonfigrev=false wificonfigrev=true wificlass=${auto == false ? '1' : inuse == false ? '2' : '3'} wifissidrev='${ssid}'"
          (box :class "wifi-option-box"
               :orientation "v"
               (box :class "wifi-ssid"
                    :space-evenly false
                    :orientation "h"
                    (label :class {auto == false ? "wifi-ssid-01" : inuse == false ? "wifi-ssid-02" : "wifi-ssid-03"}
                         :limit-width 30
                         :text ssid
                    )
               )
          )
     )
)

(defwindow wifictl
     :monitor 0
     :stacking "overlay"
     :focusable false
     :geometry (geometry
          :anchor "top right"
          :x "5px"
          :y "50px"
          :width "425px"
          :height "440px"
     )
     (revealer
          :transition "slidedown"
          :reveal wifictlrev
          :duration "350ms"
          (wifi_event)
     )
)

(defwidget button-module [icon cmd ?class ?subclass]
     (box :class "${class}"
          :orientation "h"
          (eventbox
               :onclick "${cmd}"
               :cursor "pointer"
               :class "${subclass}"
               (label
                    :text "${icon}"
               )
          )
     )
)

(defwidget menu []
     (button-module :class "menu"
          :subclass "menu-eventbox"
          :icon " "
          :cmd "hyprctl dispatch 'hl.dsp.exec_cmd(\"qs ipc call toggleControlCenter handle\")'"
     )
)

(defwidget power []
    (box :class "power"
         :orientation "h"
         (eventbox :onclick '${wifictlrev == true ? "bash -c \"./scripts/wifictl.sh & sleep 0.233 && ./scripts/usrctl.sh &\"" : "./scripts/usrctl.sh"}'
                   :cursor "pointer"
                   :class "power-eventbox"
                   (label :text "󰻃 ")
         )
    )
)

(deflisten ws_data
     "./bin/daemon_workspace"
)

(defwidget workspaces []
     (eventbox
          :onscroll "./bin/set_workspace -i {} -o ${active_ws} && eww update active_ws=$(hyprctl activeworkspace -j | jq '.id')"
          :valign "center"
          (box :class "ws-container"
               :spacing 10
               :space-evenly false
               :valign "center"

               (for ws in ws_data
                    (eventbox
                         :cursor "pointer"
                         :onclick "hyprctl dispatch 'hl.dsp.focus({ workspace = ${ws.id}})'"
                         (box :class "ws-pill ${ws.state}")
                    )
               )
          )
     )
)

(defwidget divider []
    (label :class "div" :text "|")
)

(defwindow calendar
    :monitor 0
    :stacking "overlay"
    :geometry (geometry :anchor "top center"
                        :y "-15px"
                        :width "355px"
                        :height "41%"
    )
    (expander :expanded true
              (revealer :transition "slidedown"
                        :reveal calrev
                        :duration "350ms"
                        (calendar_event)
              )
    )
)

(defvar calrev false)

(defwidget calendar_event []
    (eventbox :onhoverlost "./scripts/calendar.sh"
         (calendar_widget :time get_time
                          :date get_date
         )
    )
)

(defwidget calendar_widget[time date]
    (box :class "calendar-container"
         :orientation "v"
         :spacing 16
         :space-evenly false
         (box :class "time-box"
              :orientation "v"
              :halign "center"
              :space-evenly false
              (box :class "time-inner"
                   (label :text "${time}")
              )
              (box :class "date-inner"
                   (label :text "${date}")
              )
         )
         (box :class "calendar-box"
              :halign "center"
              (calendar :class "cal")
         )
    )
)

(defwidget time [time]
    (eventbox :cursor "pointer"
              :onclick "./scripts/calendar.sh"
              :width 120
              :height 25
              :class "time-label"
              (label :text "${time}")
    )
)

(defpoll get_date :interval "1s"
                  "date +'%d.%m.%Y, %A'"
)

(defpoll get_time :interval "1s"
                  "date +%H:%M:%S"
)

(defpoll get_uptime :interval "1s"
                  "uptime -p"
)

(defwindow usrctl
    :monitor 0
    :stacking "overlay"
    :geometry (geometry :anchor "top right"
                        :x "5px"
                        :y "-4px"
                        :width "425px"
                        :height "993px"
    )
    (box :space-evenly false
         :halign "end"
              (revealer :transition "slideleft"
                        :reveal ctlrev
                        :duration "350ms"
                        (usrctl-widget :uptime get_uptime)
              )
    )
)

(defvar ctlrev false)

(defwidget usrctl-widget [uptime]
    (box :space-evenly false
         :valign "start"
    (eventbox :class "shadow-container"
         :onhoverlost "./scripts/usrctl.sh"
         (box :orientation "v"
              :space-evenly false
         (box :class "main-container"
              :orientation "v"
              :halign "center"
              (box :class "monitor-container"
                   :orientation "v"
                   :space-evenly false
                   (box :class "sysctl"
                        :orientation "v"
                        :space-evenly false
                        (box :class "bats"
                             :space-evenly false
                             (box :class "batico-main"
                                  (box :class "${battery_data.class}"
                                        (label :text "${battery_data.icon}")
                                   )
                             )
                             (box :class "bat-detail"
                                  :orientation "v"
                                  (box :class "bat-percent"
                                       :space-evenly false
                                       (label :text "Battery ${battery_data.capacity}%")
                                  )
                                  (box :class "bat-status"
                                       :space-evenly false
                                       (label :limit-width 26 :text "${battery_data.status}: ${battery_data.time_left}")
                                  )
                             )
                        )
                   )
              )
         )
     ;     (cpu-panel)
         )
    ))
)

(defwidget cpu-panel []
    (box :class "cpu-container"
         :orientation "v"
         :space-evenly false
         (box :orientation "h"
              :class "cpu-header"
              :space-evenly false
              (label :text "Temperature Monitor" :style "color:#cdd6f4;font-size:20px;")
         )
         (box :class "graph-container"
              :orientation "v"
              :space-evenly false
              (overlay
              (graph :thickness 2
                     :dynamic true
                     :height "100"
                     :width "350"
                     :class "graph-display"
                     :time-range "300s"
                     :min 0
                     :max 101
                     :value {EWW_TEMPS.CORETEMP_PACKAGE_ID_0}
              )
              (box :class "main-temp"
                   :halign "start"
                   :valign "end"
                   (label :class "main-temp-text" :text "${EWW_TEMPS.CORETEMP_PACKAGE_ID_0} °C")
              )
              )
         )
         (box :class "minicore-container"
              :orientation "v"
              :space-evenly false
              (box :class "minicores"
                   (label :class "C0" :text "Core 0: ${EWW_TEMPS.CORETEMP_CORE_0} °C")
                   (label :class "C1" :text "Core 1: ${EWW_TEMPS.CORETEMP_CORE_1} °C")
              )
              (box :class "minicores"
                   (label :class "C2" :text "Core 2: ${EWW_TEMPS.CORETEMP_CORE_2} °C")
                   (label :class "C3" :text "Core 3: ${EWW_TEMPS.CORETEMP_CORE_3} °C")
              )
         )

    )
)


(defwindow topbar
    :monitor 0
    :stacking "fg"          ;; Changed from "bg" to "fg" so it's not hidden by wallpaper
    :exclusive true         ;; Tells the WM to reserve space so windows don't overlap the bar
    :windowtype "dock"      ;; Critical for some WMs to treat it as a bar
    :wm-ignore false
    :geometry (geometry :anchor "top center"
                        :x "0%"
                        :y "5px"        ;; Added a tiny offset from the top
                        :width "99%"    ;; 99.5% is fine, but 99% gives a nice gap on the sides
                        :height "40px"  ;; Using pixels is usually more reliable than % for height
    )
    (bar)
)
